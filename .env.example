# Copy this file to .env for local use. Never put real keys in this file (it is committed to GitHub).
MAYA_PUBLIC_KEY=pk-your-sandbox-public-key
MAYA_SECRET_KEY=sk-your-sandbox-secret-key

MAYA_BASE_URL=https://pg-sandbox.paymaya.com

SITE_URL=http://127.0.0.1:8000

# 1 = if Maya cannot be reached, use a simulated "demo checkout" page instead of failing (for demos only).
DEMO_PAYMENTS=0

PHILSMS_API_TOKEN=your-philsms-token
PHILSMS_SENDER_ID=PhilSMS
SMS_OWNER_NUMBER=09XXXXXXXXX
